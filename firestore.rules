rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.phone_number == '+918465834152';
    }
    // Chat ids are the two user ids, sorted and joined with "_" (getChatId) — so membership is in the id itself.
    function isChatMember(chatId) {
      return isAuth() && request.auth.uid in chatId.split('_');
    }
    function isParty(data) {
      return isAuth() && (request.auth.uid == data.companyId || request.auth.uid == data.seekerId);
    }

    // ── User profiles ───────────────────────────────────────
    match /seekers/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /companies/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Usernames ───────────────────────────────────────────
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Likes ───────────────────────────────────────────────
    // Top-level likes documents (legacy/admin queries)
    match /likes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection likes (likes/{userId}/outgoing/{docId}, likes/{userId}/incoming/{docId})
    match /likes/{userId}/{sub}/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Passes ──────────────────────────────────────────────
    // Top-level passes documents (legacy/admin queries)
    match /passes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection passes (passes/{userId}/passed/{docId})
    match /passes/{userId}/{sub}/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAuth();
    }

    // ── Matches ─────────────────────────────────────────────
    // Top-level matches documents (legacy/admin queries)
    match /matches/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection matches (matches/{userId}/matched/{docId})
    match /matches/{userId}/{sub}/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }


    // ── Chats ───────────────────────────────────────────────
    // Reads are scoped to the chat's participants (or admin). Previously ANY
    // authenticated user could read EVERY chat and message — a privacy leak, since
    // phone numbers, addresses and project details are exchanged here. Every chat
    // doc is created with a `participants` array, and the app only ever queries
    // chats via `where('participants','array-contains', uid)`, so this is safe.
    match /chats/{chatId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid in resource.data.participants);
      allow create, update: if isAdmin() || isChatMember(chatId);
      allow delete: if isAdmin() || isChatMember(chatId);

      match /messages/{messageId} {
        // A message is readable only by participants of its parent chat (or admin).
        allow read: if isAdmin() || (isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAdmin() || (isChatMember(chatId) &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system'));
        allow update: if isAdmin() || isChatMember(chatId);   // read receipts
        allow delete: if isAdmin() || isChatMember(chatId);   // account deletion clears the user's chats
      }
    }

    // ── Meetings ────────────────────────────────────────────
    // TODO(security): reads are still open to any authenticated user. Cannot scope to
    // companyId/seekerId yet because company discovery runs a GLOBAL meetings query
    // (where status in [...]) to deprioritise already-requested seekers. Tighten this
    // once that query is moved server-side or reworked to be owner-scoped.
    match /meetings/{meetingId} {
      allow read: if isAuth();
      allow create: if isAdmin() || isParty(request.resource.data);
      allow update: if isAdmin() || (isParty(resource.data)
                      && request.resource.data.companyId == resource.data.companyId
                      && request.resource.data.seekerId == resource.data.seekerId
                      && request.resource.data.get('meetingFee', 0) == resource.data.get('meetingFee', 0));
      allow delete: if isAdmin() || isParty(resource.data);
    }

    // ── Wallets ─────────────────────────────────────────────
    // Balance/lockedBalance mutations are SERVER-AUTHORITATIVE: all money moves (top-up,
    // meeting settlement, project unlock, advance confirmation) run in /api/wallet/*
    // via the Admin SDK, which bypasses these rules. Clients can no longer write wallet
    // balances — this is what closes the self-crediting hole. A user may still CREATE
    // their own EMPTY (zero-balance) wallet at signup; all balance changes go through the
    // server, and admin retains manual edit access.
    match /wallets/{userId} {
      allow read: if isAuth();
      allow create: if isAdmin() || (isOwner(userId)
                      && request.resource.data.balance == 0
                      && (!('lockedBalance' in request.resource.data) || request.resource.data.lockedBalance == 0));
      allow update: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Transactions ────────────────────────────────────────
    // A user can read only their own transactions (userId == them). Admin reads all.
    // Every transaction is written with userId = the wallet owner it affects, and the
    // app queries with `where('userId','==', uid)`, so owner-scoped reads are safe.
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin();   // money history is written by the server (Admin SDK)
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid); // account deletion
    }

    // ── Withdrawals ─────────────────────────────────────────
    match /withdrawals/{wId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ── Projects ────────────────────────────────────────────
    // Readable only by the two parties (company/seeker) or admin. The app always
    // queries projects filtered by companyId or seekerId == the current user.
    match /projects/{projectId} {
      allow read: if isAdmin() || (isAuth() &&
        (resource.data.companyId == request.auth.uid || resource.data.seekerId == request.auth.uid));
      allow create: if isAdmin() || isParty(request.resource.data);
      allow update: if isAdmin() || (isParty(resource.data)
                      && request.resource.data.companyId == resource.data.companyId
                      && request.resource.data.seekerId == resource.data.seekerId);
      allow delete: if isAdmin() || isParty(resource.data);
    }

    // ── Reviews ─────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create, update: if isAuth()
                      && request.resource.data.seekerId == request.auth.uid
                      && reviewId == request.auth.uid + '_' + request.resource.data.companyId
                      && request.resource.data.rating is number
                      && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if isAdmin() || (isAuth() && resource.data.seekerId == request.auth.uid);
    }

    // ── Notifications ───────────────────────────────────────
    match /notifications/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /items/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuth();   // the app notifies the other person (meeting requests, messages)
        allow update: if isOwner(userId) || isAdmin();   // mark as read
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ── Delete Requests ─────────────────────────────────────
    match /deleteRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── FCM Tokens ──────────────────────────────────────────
    match /fcmTokens/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Private contact details (phone numbers) ─────────────
    // Only the owner and the admin can read them. The other side of a meeting gets the number through
    // /api/contact (server checks the meeting). Owners can only store their own verified login number.
    match /contacts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() || (isOwner(userId) && request.resource.data.phone == request.auth.token.phone_number);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── AI nudge log (server only: /api/ai/platform) ─────────
    match /aiNudges/{userId} {
      allow read, write: if isAdmin();
    }
  }
}

