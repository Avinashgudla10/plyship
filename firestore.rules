rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.phone_number == '+918465834152';
    }

    // ── User profiles ───────────────────────────────────────
    match /seekers/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /companies/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Usernames ───────────────────────────────────────────
    match /usernames/{username} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── Likes ───────────────────────────────────────────────
    // Top-level likes documents (legacy/admin queries)
    match /likes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection likes (likes/{userId}/outgoing/{docId}, likes/{userId}/incoming/{docId})
    match /likes/{userId}/{sub}/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Passes ──────────────────────────────────────────────
    // Top-level passes documents (legacy/admin queries)
    match /passes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection passes (passes/{userId}/passed/{docId})
    match /passes/{userId}/{sub}/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAuth();
    }

    // ── Matches ─────────────────────────────────────────────
    // Top-level matches documents (legacy/admin queries)
    match /matches/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    // Sub-collection matches (matches/{userId}/matched/{docId})
    match /matches/{userId}/{sub}/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }


    // ── Chats ───────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }
    }

    // ── Meetings ────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Wallets ─────────────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isAuth();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Transactions ────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Withdrawals ─────────────────────────────────────────
    match /withdrawals/{wId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Projects ────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Reviews ─────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Notifications ───────────────────────────────────────
    match /notifications/{userId} {
      allow read, write: if isAuth();

      match /items/{itemId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ── Delete Requests ─────────────────────────────────────
    match /deleteRequests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── FCM Tokens ──────────────────────────────────────────
    match /fcmTokens/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}

