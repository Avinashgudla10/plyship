<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>PLYSHIP</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- App Store: Skip export compliance questionnaire (standard HTTPS only) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ATS: Strict HTTPS enforcement (default). No exceptions needed.
	     plyship.com uses HTTPS. WebView content inherits default ATS. -->

	<!-- URL Schemes: Required for Firebase Phone Auth reCAPTCHA redirect -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.plyship.app</string>
				<!-- TODO: Add your REVERSED_CLIENT_ID from GoogleService-Info.plist here -->
				<!-- Example: <string>com.googleusercontent.apps.109538013062-XXXXXXXXXXXX</string> -->
			</array>
		</dict>
	</array>

	<!-- Privacy: Camera & Photo access (needed for profile photo uploads in the web app) -->
	<key>NSCameraUsageDescription</key>
	<string>PLYSHIP needs camera access to take profile photos and share images.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PLYSHIP needs photo library access to upload and share photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PLYSHIP needs permission to save images to your photo library.</string>

	<!-- Privacy: Location access (needed for auto-detecting city during signup) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PLYSHIP needs your location to find interior designers near you and show your city on your profile.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>PLYSHIP uses your location to find interior designers near you, show your city on your profile, and keep your location updated.</string>

	<!-- Background Modes: Required for "Always Allow" location permission -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- Privacy: Microphone access (needed for voice notes in chat) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>PLYSHIP needs microphone access to record voice notes in chat conversations.</string>

	<!-- URL Schemes the app needs to query (UPI payment apps for Razorpay) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>upi</string>
		<string>phonepe</string>
		<string>gpay</string>
		<string>paytm</string>
		<string>tez</string>
		<string>bhim</string>
		<string>comgooglemaps</string>
		<string>maps</string>
	</array>
</dict>
</plist>
