# Copy this file to `keystore.properties` (same folder) and fill in your real
# values, then run a release build. keystore.properties is gitignored.
#
#   storeFile is resolved relative to the android/ folder.
#
storeFile=plyship-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
